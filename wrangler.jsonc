{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "free-live-chat-for-slack",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",

  "observability": {
    "enabled": true
  },

  // Serves public/widget.js, the script you embed on your website
  "assets": {
    "directory": "./public"
  },

  // One Durable Object per chat: WebSocket connections and the transcript
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_SESSION",
        "class_name": "ChatSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChatSession"]
    }
  ],

  // Maps Slack threads to chats
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "live-chat-db",
      "database_id": "YOUR_D1_DATABASE_ID"
    }
  ],

  // Files sent in the chat
  "r2_buckets": [
    {
      "binding": "FILES_BUCKET",
      "bucket_name": "live-chat-files"
    }
  ],

  // At most 5 new chats per minute from one IP address (counted per Cloudflare location)
  "ratelimits": [
    {
      "name": "START_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],

  // Optional AI bot. Uncomment both blocks after following docs/AI_CHATBOT.md.
  // "ai": {
  //   "binding": "AI"
  // },
  // "vectorize": [
  //   {
  //     "binding": "SUPPORT_INDEX",
  //     "index_name": "support-knowledge-base"
  //   }
  // ],

  "vars": {
    // Channel ID (C0123456789), not the name
    "SLACK_CHANNEL_ID": "YOUR_SLACK_CHANNEL_ID",
    // Exact origins that may embed the chat, comma-separated. Add http://localhost:4321 etc. for local testing.
    "ALLOWED_ORIGINS": "https://your-website.com"
  },

  // Secrets, set with `npx wrangler secret put <NAME>` (locally: .dev.vars):
  //   SLACK_BOT_TOKEN         Bot token (xoxb-…)
  //   SLACK_SIGNING_SECRET    Verifies that webhook calls come from Slack
  //   TURNSTILE_SECRET_KEY    Spam protection for new chats (strongly recommended)
  //   TICKET_WEBHOOK_URL      Optional: receives the transcript when a visitor leaves contact details
  //   TICKET_WEBHOOK_SECRET   Optional: sent to that webhook as "Authorization: Bearer <secret>"

  "dev": {
    "port": 8787
  }
}
