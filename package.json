{
  "name": "free-live-chat-for-slack",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "db:migrate": "wrangler d1 migrations apply live-chat-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply live-chat-db --local",
    "vectorize:create": "wrangler vectorize create support-knowledge-base --dimensions=1024 --metric=cosine",
    "embeddings:prepare": "tsx scripts/prepare-embeddings.ts",
    "models:test": "tsx scripts/test-models.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250121.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "wrangler": "^4.7.1"
  }
}
